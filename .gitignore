# macOS clutter
.DS_Store

# Claude Code's own files: machine-local config, agents, skills, commands.
# Personal and local by rule, so the whole directory is ignored rather than the
# one file that happens to be in it today.
.claude/

# Internal notes: design specs, plans, research and the official exam guides
# (docs/guides/). Kept on disk, but not tracked in git.
docs/

# Anthropic's copyrighted material. The guides live in docs/guides/ and are
# covered by the rule above — this is a second net, in case a PDF ends up
# somewhere else in the repo by accident.
*.pdf

# Claude's own files: the session-start pointer, the working list, and the repo
# notes it reads at session start. Local like everything else Claude-shaped,
# never in the repo.
RESUME.md
TODO.md
CLAUDE.md
